# Kopyalayın: cp .env.local.example .env.local
# .env.local repoya eklenmez (.gitignore). Gerçek şifreleri yalnızca .env.local içine yazın.
#
# Keycloak container (docker-compose keycloak servisi) bu dosyayı okur.
# Backend için ayrıca backend/finance-portal-backend/.env.local kullanılıyor.
#
# Keycloak 26 realm SMTP ayarlarını bu env değişkenlerinden OTOMATİK okumaz.
# Aynı değerleri Admin Console → Realm settings → Email bölümüne girin (bkz. docs/keycloak-smtp-faz-a.md).

KC_HOSTNAME=localhost
KC_HOSTNAME_PORT=8081
KC_HOSTNAME_STRICT=false

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM=your-gmail-address@gmail.com
SMTP_FROM_DISPLAY_NAME=Portiva
SMTP_REPLY_TO=your-gmail-address@gmail.com
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASSWORD=your-google-app-password-here
