{
  "timestamp": {
    "$resolver": "timestamp",
    "pattern": {
      "format": "yyyy-MM-dd'T'HH:mm:ss.SSS'Z'",
      "timeZone": "UTC"
    }
  },
  "level": {
    "$resolver": "level",
    "field": "name"
  },
  "serviceName": "finance-portal-backend",
  "logger": {
    "$resolver": "logger",
    "field": "name"
  },
  "thread": {
    "$resolver": "thread",
    "field": "name"
  },
  "message": {
    "$resolver": "message",
    "stringified": true
  },
  "exception": {
    "$resolver": "exception",
    "field": "stackTrace",
    "stringified": true
  },
  "requestId": {
    "$resolver": "mdc",
    "key": "requestId"
  },
  "method": {
    "$resolver": "mdc",
    "key": "method"
  },
  "path": {
    "$resolver": "mdc",
    "key": "path"
  },
  "status": {
    "$resolver": "mdc",
    "key": "status"
  },
  "durationMs": {
    "$resolver": "mdc",
    "key": "durationMs"
  },
  "userId": {
    "$resolver": "mdc",
    "key": "userId"
  },
  "traceId": {
    "$resolver": "mdc",
    "key": "traceId"
  },
  "spanId": {
    "$resolver": "mdc",
    "key": "spanId"
  },
  "trace_id": {
    "$resolver": "mdc",
    "key": "trace_id"
  },
  "span_id": {
    "$resolver": "mdc",
    "key": "span_id"
  },
  "category": {
    "$resolver": "mdc",
    "key": "category"
  },
  "eventType": {
    "$resolver": "mdc",
    "key": "eventType"
  },
  "clientIp": {
    "$resolver": "mdc",
    "key": "clientIp"
  }
}
