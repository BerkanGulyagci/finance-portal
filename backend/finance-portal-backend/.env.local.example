# =============================================================================
# .env.local ŞABLONU — kopyala ve değerleri doldur:   cp .env.local.example .env.local
# .env.local GİT'E COMMİT EDİLMEZ (gitignore'lu). Yeni sunucuya scp ile elle taşınır.
# Burada SADECE anahtar isimleri + nereden alınacağı var; gerçek değer YOK.
# =============================================================================

# --- TCMB EVDS (faiz/enflasyon/makro) — https://evds3.tcmb.gov.tr/ → Kayıt / API ---
EVDS_API_KEY=your-evds-api-key-here

# --- FRED (ABD CPI / küresel makro) — https://fred.stlouisfed.org/docs/api/api_key.html ---
# Boşsa ABD Enflasyonu (CPI) göstergesi boş kalır; diğer her şey çalışır.
FRED_API_KEY=

# --- Keycloak admin-service client (backend → Keycloak Admin REST API) ---
# Local dev URL: http://localhost:8081 | container içi: http://finance-portal-keycloak:8080
KEYCLOAK_ADMIN_URL=http://finance-portal-keycloak:8080
KEYCLOAK_ADMIN_REALM=finance-portal
KEYCLOAK_ADMIN_CLIENT_ID=finance-portal-admin-service
KEYCLOAK_ADMIN_CLIENT_SECRET=finance-portal-demo-secret-change-in-prod   # Demo değer — realm import ile eşleşir; ÜRETİMDE Keycloak'tan yeniden üretin
KEYCLOAK_DEFAULT_USER_ROLE_ID=98436eeb-2961-41e5-a23d-c150db93d649 # USER realm rolü ID'si (realm import ile sabit gelir)

# --- SMTP (alarm/bildirim e-postaları) — Gmail için "uygulama şifresi" (App Password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM=
SMTP_FROM_DISPLAY_NAME=Portiva
SMTP_REPLY_TO=
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_USER=
SMTP_PASSWORD=                       # Gmail App Password (16 hane, boşluksuz)

# --- Haber sağlayıcıları (boşsa ilgili sağlayıcı pasif kalır) ---
FINNHUB_API_KEY=

# --- Porti sohbet asistanı ---
# Groq (birincil, ücretsiz, OpenAI-uyumlu) — https://console.groq.com
ASSISTANT_API_KEY=
ASSISTANT_MODEL=llama-3.3-70b-versatile
# Gemini (fallback — Groq kota/hata verince) — https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Diğer piyasa veri kaynakları ---
COINGECKO_API_KEY=
TEFAS_BEARER_TOKEN=
