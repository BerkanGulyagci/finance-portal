# Bu dosyayı kopyalayın: cp .env.local.example .env.local
# EVDS API anahtarı: https://evds3.tcmb.gov.tr/ → Kayıt / API
#
# Keycloak SMTP + hostname (docker-compose keycloak servisi):
# Repo kökündeki .env.local.example → .env.local dosyasına bakın.

EVDS_API_KEY=your-evds-api-key-here

# Keycloak Admin REST API (finance-portal-admin-service client credentials)
# Local dev: http://localhost:8081
KEYCLOAK_ADMIN_URL=http://localhost:8081
KEYCLOAK_ADMIN_REALM=finance-portal
KEYCLOAK_ADMIN_CLIENT_ID=finance-portal-admin-service
KEYCLOAK_ADMIN_CLIENT_SECRET=your-client-secret-here
